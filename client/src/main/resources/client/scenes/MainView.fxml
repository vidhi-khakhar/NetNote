            <HBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="278.0" prefWidth="224.0" style="-fx-border-color: black; -fx-border-width: 1;" VBox.vgrow="ALWAYS">
